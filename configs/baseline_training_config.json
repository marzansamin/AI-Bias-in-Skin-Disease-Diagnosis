{
  "model": "EfficientNet-B0",
  "pretrained": true,
  "num_classes": 114,
  "loss": {
    "name": "CrossEntropyLoss",
    "class_weighting": false,
    "label_smoothing": 0.0
  },
  "optimizer": {
    "name": "AdamW",
    "learning_rate": 0.0001,
    "weight_decay": 0.0001
  },
  "scheduler": {
    "name": "ReduceLROnPlateau",
    "mode": "min",
    "factor": 0.1,
    "patience": 2,
    "min_lr": 1e-07,
    "monitor": "validation_loss"
  },
  "training": {
    "epochs": 10,
    "batch_size": 32
  }
}